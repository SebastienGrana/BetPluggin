{% extends 'core.views/generics/widget.xml' %}

{% block content %}
  <quad pos="0 0" z-index="0" size="40 15.5" bgcolor="0F0F1AE0"/>

  <quad pos="1.2 -1.2" z-index="1" size="8 2.6" bgcolor="{{ status_color }}"/>
  <label pos="5.2 -2.3" z-index="2" size="8 2.6" textsize="1" halign="center" valign="center" textcolor="000000FF" text="{{ status }}"/>

  <label pos="10.2 -2.4" z-index="1" size="28.8 2.6" textsize="1.05" valign="center" textcolor="CCCCCCFF"
         text="{{ period_label }}"/>

  <label pos="1.2 -5.7" z-index="1" size="37.6 2.6" textsize="1.05" valign="center" textcolor="CCCCCCFF"
         text="{{ total_pot }} planets played -- {{ bet_count }} {{ bet_word }}"/>

  <quad pos="0 -7.9" z-index="1" size="40 3.6" bgcolor="09F4FF33" action="{{ id }}__open_market" scriptevents="1"/>
  <label pos="20 -9.5" z-index="2" size="38 3" textsize="1.1" halign="center" valign="center" textcolor="FFFFFFFF"
         text="Open &#171; betting market &#187;" action="{{ id }}__open_market" scriptevents="1"/>

  <!-- Secondary row. Everything the plugin can show used to be reachable only by typing a command, which
       in practice means nobody but the author knows it exists. Dimmer and smaller than the market button
       on purpose: placing a bet stays the one obvious thing to click. -->
  <!-- Each button carries the colour of the window it opens (see BetListStyleMixin.ACCENTS), so the panel
       that appears is visibly the one that was clicked. -->
  <quad pos="0.8 -12" z-index="1" size="12.6 3" bgcolor="2FC06A44" action="{{ id }}__open_targets" scriptevents="1"/>
  <label pos="7.1 -13.5" z-index="2" size="12 2.6" textsize="0.9" halign="center" valign="center" textcolor="DDDDDDFF"
         text="Who to bet on" action="{{ id }}__open_targets" scriptevents="1"/>

  <quad pos="13.7 -12" z-index="1" size="12.6 3" bgcolor="E0A93044" action="{{ id }}__open_leaderboard" scriptevents="1"/>
  <label pos="20 -13.5" z-index="2" size="12 2.6" textsize="0.9" halign="center" valign="center" textcolor="DDDDDDFF"
         text="Leaderboard" action="{{ id }}__open_leaderboard" scriptevents="1"/>

  <quad pos="26.6 -12" z-index="1" size="12.6 3" bgcolor="FFFFFF18" action="{{ id }}__open_wallet" scriptevents="1"/>
  <label pos="32.9 -13.5" z-index="2" size="12 2.6" textsize="0.9" halign="center" valign="center" textcolor="DDDDDDFF"
         text="My stats" action="{{ id }}__open_wallet" scriptevents="1"/>
{% endblock %}

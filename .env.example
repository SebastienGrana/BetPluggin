# Copy this file to ".env" (gitignored) and fill in the real values.

# Your own ManiaPlanet/Trackmania login -- gets full owner permissions in PyPlanet.
PYPLANET_OWNER_LOGIN=your-maniaplanet-login

# --- PyPlanet's own connection to whichever dedicated server it should control ---
#
# For LOCAL DEV against the bundled Docker dedicated server (`docker compose --profile dev up`):
# leave these as-is. `tm-dedicated` is the compose service name (resolved over the docker network),
# and SuperAdmin/SuperAdmin comes from docker/tm-dedicated-config.txt.
#
# For a REMOTE/rented server (e.g. ManiaServ), replace all four with the RPC host/port/login/password
# from their panel instead, and just don't pass --profile dev (the dev dedicated server then never starts).
PYPLANET_RPC_HOST=tm-dedicated
# 5010, not the default 5000: the ManiaPlanet *game client* itself holds 127.0.0.1:5000 (and 2350)
# while it's running, so the dev server uses 2360/3460/5010 instead -- see
# docker/tm-dedicated-config.txt.
PYPLANET_RPC_PORT=5010
PYPLANET_RPC_USER=SuperAdmin
PYPLANET_RPC_PASSWORD=SuperAdmin

# --- Local dev dedicated server only (pyplanet/maniaplanet-dedicated image, Trackmania2 Stadium) ---
# Free dedicated server login, create one at https://maniaplanet.com/account/dedicated-servers
# (make up any name/password, it's separate from your normal player login).
TM_DEDICATED_LOGIN=your-dedicated-server-login
TM_DEDICATED_PASSWORD=your-dedicated-server-password

# Your machine's LAN IP (run `ipconfig` and look for the Ethernet/Wi-Fi adapter's IPv4 address).
# Needed so the master server registers a join address your own game client can actually reach.
TM_DEDICATED_FORCE_IP=192.168.1.20

PYPLANET_DEBUG=false

# --- BetPluggin dev-only escape hatch ---
# The local dev dedicated server's login can't pass Nadeo's billing validation, so SendBill/Pay always
# fail (see README's "Real payments don't work..." section). Set this to true to bypass real payments
# entirely: bets confirm and resolve instantly, with clearly-labelled "(fake payment mode)" chat
# messages, so you can test the full bet -> resolve -> payout -> leaderboard flow solo.
# NEVER set this to true on a real/live server -- it hands out free wins.
BETPLUGGIN_FAKE_PAYMENTS=false
